# Kept out of the image: things rebuilt inside it, local data, and secrets.
node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
dist
coverage

# The local database and uploaded pictures. Production keeps these elsewhere.
.data

# Secrets never go into an image. The host supplies them as settings.
.env
.env.*
!.env.example
**/.env.local

.git
.github
