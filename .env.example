# Copy to apps/web/.env.local for local development.

# Leave unset to use the embedded PGlite database at .data/pglite (no install needed).
# Set to a postgres:// URL to use a real PostgreSQL server (required for the worker).
# DATABASE_URL=postgres://worldroot:worldroot@localhost:5432/worldroot

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional sign-in with Discord and Google. A provider is enabled only when both of its values are set.
# In each provider's settings, the redirect address is BETTER_AUTH_URL followed by
# /api/auth/callback/discord or /api/auth/callback/google. See docs/deploy/railway.md.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The platform administrator. On start, the account with this email is made WorldRoot staff.
# If it does not exist yet and a password is given, it is created with that password.
# Put real values in apps/web/.env.local, which git ignores. Never commit them.
# WORLDROOT_ADMIN_EMAIL=
# WORLDROOT_ADMIN_PASSWORD=
# On your own machine only: also apply that password to an account that already exists.
# Ignored unless the built-in local database is in use.
# WORLDROOT_ADMIN_PASSWORD_SYNC=true

# Behind a host's proxy: the header the host puts each visitor's address in, so sign-in attempts are
# limited per visitor and not for everyone at once. On Railway this is x-real-ip. Leave unset locally.
# WORLDROOT_CLIENT_IP_HEADER=x-real-ip

# The address shown on the privacy policy and the terms for questions and deletion requests.
# Without it those pages tell people to message a Rootwarden instead.
# WORLDROOT_CONTACT_EMAIL=

# The demo communities (Demo Town and Demo Dungeon). On the built-in database they load unless this is off.
# On a real server they load only when this is on, and the administrator is made an owner of both.
# WORLDROOT_DEMO=on
# On a real server: a password for the demo account, host@worldroot.test, at least 10 characters.
# Without it nobody can sign in to that account. Anyone who knows it can act as the owner of the
# demo communities, so do not publish it.
# WORLDROOT_DEMO_PASSWORD=

# On a real server: open the shared guest account, so anyone can try the demo from the sign-in page
# without making an account. Needs WORLDROOT_DEMO=on. Remove it to close the guest account again.
# WORLDROOT_DEMO_GUEST=on

# Where the Donate button on /support goes: your page on a donation service. Must start with https://.
# Without it the page says donations are not open yet.
# WORLDROOT_DONATE_URL=

# Where uploaded images are kept. Defaults to .data/media in the repository.
# Every web server must see the same folder; with more than one, use shared storage.
# WORLDROOT_MEDIA_DIR=
