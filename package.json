{
  "name": "worldroot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @worldroot/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @worldroot/db generate",
    "db:migrate": "pnpm --filter @worldroot/db migrate",
    "seed:demo": "pnpm --filter @worldroot/core seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "catalog:",
    "globals": "^17.13.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
